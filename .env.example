# Server
PORT=3100
PUBLIC_API_URL=https://api.example.com
DASHBOARD_ORIGIN=https://api.example.com
JSON_BODY_LIMIT=512kb
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rithan_link_dm
DB_USER=rithan_link_dm_app
DB_PASSWORD=replace-with-a-strong-password

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
INSTAGRAM_QUEUE_NAME=instagram-comment-jobs
INSTAGRAM_ACCOUNT_MIN_INTERVAL_MS=1000

# Meta / Instagram
META_VERIFY_TOKEN=replace-with-random-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
INSTAGRAM_APP_ID=replace-with-instagram-app-id
INSTAGRAM_APP_SECRET=replace-with-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://api.example.com/auth/instagram/callback
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_TOKEN_REFRESH_WINDOW_DAYS=10

# Token encryption
# 64 hex characters = 32 bytes for AES-256-GCM.
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
TOKEN_ENCRYPTION_KEY_VERSION=1

# Sessions / auth
SESSION_COOKIE_NAME=rithan_link_dm_session
SESSION_COOKIE_SECURE=true
SESSION_DAYS=30
MAX_ACTIVE_SESSIONS=5
REVOKED_SESSION_RETENTION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# API mutation limiter
API_MUTATION_RATE_WINDOW_SECONDS=60
API_MUTATION_RATE_MAX_REQUESTS=120

# Retention / operations
WEBHOOK_EVENT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
OAUTH_STATE_RETENTION_DAYS=7
POSTGRES_BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=36
QUEUE_BACKLOG_ALERT_THRESHOLD=100
QUEUE_OLDEST_JOB_ALERT_SECONDS=300
DISK_USAGE_ALERT_PERCENT=85

# Optional outbound operations alert webhook.
# Receives health-check JSON when warnings/critical failures occur.
OPS_ALERT_WEBHOOK_URL=

# Commercial mode. Keep private_beta until checkout is genuinely ready.
BILLING_PURCHASE_MODE=private_beta
BILLING_CONTACT_URL=
BILLING_CHECKOUT_URL=
