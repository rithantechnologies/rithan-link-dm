[Unit]
Description=Rithan Link DM Instagram Worker
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=simple

WorkingDirectory=/var/www/rithan-link-dm-api

ExecStart=/usr/bin/node /var/www/rithan-link-dm-api/worker.js

EnvironmentFile=/var/www/rithan-link-dm-api/.env

Restart=always
RestartSec=5

User=root

[Install]
WantedBy=multi-user.target
