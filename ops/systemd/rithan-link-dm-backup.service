[Unit]
Description=Rithan Link DM PostgreSQL Backup
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=rithanlinkdm
Group=rithanlinkdm
WorkingDirectory=/var/www/rithan-link-dm-api
EnvironmentFile=/var/www/rithan-link-dm-api/.env
Environment=POSTGRES_BACKUP_DIR=/var/backups/rithan-link-dm/postgres
Environment=POSTGRES_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/bin/node /var/www/rithan-link-dm-api/scripts/backup-postgres.js
ExecStartPost=/usr/bin/node /var/www/rithan-link-dm-api/scripts/verify-postgres-backup.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/backups/rithan-link-dm/postgres
